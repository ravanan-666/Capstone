# DjMart Environment Variables (Template)
# Copy this file to .env or configure in your deployment environment

# Server / Application
APP_ENV=development
APP_PORT=8080
APP_SECRET_KEY=djmart-secret-key-change-in-production

# H2 Database Configuration
# Local embedded mode (development):
DB_URL=jdbc:h2:./data/djmart;DB_CLOSE_DELAY=-1;MODE=REGULAR
# Remote server mode (production reference):
# DB_URL=jdbc:h2:tcp://localhost:9092/./data/djmart
DB_USER=sa
DB_PASSWORD=
DB_DRIVER=org.h2.Driver

# HikariCP Connection Pool Settings
HIKARI_MAX_POOL_SIZE=10
HIKARI_MIN_IDLE=2
HIKARI_IDLE_TIMEOUT_MS=30000
HIKARI_CONNECTION_TIMEOUT_MS=20000
HIKARI_MAX_LIFETIME_MS=1800000
HIKARI_LEAK_DETECTION_THRESHOLD_MS=15000

# AI Chatbot Configuration (Optional Phase 3)
AI_CHATBOT_PROVIDER=mock
AI_CHATBOT_API_KEY=
